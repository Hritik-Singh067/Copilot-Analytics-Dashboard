# Copy to .env and replace this with the connection string from Neon Console > Connect.
DATABASE_URL=postgresql://<user>:<password>@<host>/neondb?sslmode=require
# For local Docker instead:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/copilot_adoption

PORT=4000

# Gemini API credentials for the dashboard's "Analyze with AI" assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
