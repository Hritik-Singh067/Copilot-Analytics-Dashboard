# Copy to .env. The Docker command in the README maps Postgres to host port 5433.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=copilot_adoption
DB_USER=postgres
DB_PASSWORD=postgres
# or: DATABASE_URL=postgresql://postgres:postgres@localhost:5433/copilot_adoption

PORT=4000

# Gemini API credentials for the dashboard's "Analyze with AI" assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
